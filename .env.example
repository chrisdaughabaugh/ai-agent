# Anthropic API key — get at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Gumroad personal access token — get at https://app.gumroad.com/settings/advanced
GUMROAD_ACCESS_TOKEN=your_token_here

# Optional: your name to use as the author on products
AUTHOR_NAME=Your Name

# Optional: how many products to create per run (default: 1)
PRODUCTS_PER_RUN=1
